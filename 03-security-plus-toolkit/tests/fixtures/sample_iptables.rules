*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -p tcp --dport 22 -j ACCEPT
-A INPUT -p tcp -s 0.0.0.0/0 --dport 23 -j ACCEPT
-A INPUT -p tcp --dport 3389 -j ACCEPT
-A INPUT -p tcp -s 10.0.0.0/24 --dport 3306 -j ACCEPT
-A INPUT -p tcp --dport 443 -j ACCEPT
-A INPUT -j DROP
COMMIT
